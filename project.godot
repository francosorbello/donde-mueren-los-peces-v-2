; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

instance_dock/scene_data_file="res://InstanceDockSceneData.txt"
instance_dock/preview_resolution=Vector2i(64, 64)

[application]

config/name="donde-mueren-los-peces-v2"
run/main_scene="uid://2d2lc8oqhw1l"
config/features=PackedStringArray("4.5", "GL Compatibility")
run/max_fps=60
config/icon="res://icon.svg"

[audio]

general/default_playback_type.web=0

[autoload]

DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
GlobalEventSystem="*res://addons/ftr_tools/global_event_system/global_event_system.gd"
OxygenManager="*res://oxygen_manager/oxygen_manager.tscn"
CommonSfxPlayer="*res://utils/common_sfx_player.tscn"
GlobalSignal="*res://addons/ftr_tools/global_signal_system/global_signal_system.gd"
IndieBlueprintSaveManager="*res://addons/ninetailsrabbit.indie_blueprint_save/src/save_manager.gd"
Console="*res://addons/console/console.gd"
GlobalData="*res://utils/global_data/global_data.tscn"

[dialogue_manager]

runtime/balloon_path="res://balloon_tutorial/balloon_tutorial.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="viewport"
window/handheld/orientation=4
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/InstanceDock/plugin.cfg", "res://addons/console/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/ftr_tools/plugin.cfg", "res://addons/licenses/plugin.cfg", "res://addons/ninetailsrabbit.indie_blueprint_save/plugin.cfg")

